# Provider credentials are read only by provider clients and are never forwarded to tools.
OPENROUTER_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Runtime data defaults to a user data directory outside the current Git worktree.
# Any override used by coding workers must also remain outside both the target
# repository and the current Git worktree.
# ORACLE_LAB_HOME=/absolute/path/outside/repositories/oracle-lab
# ORACLE_LAB_DB=/absolute/path/outside/repositories/oracle.db
# ORACLE_LAB_ARCHIVE=/absolute/path/outside/repositories/archive
# ORACLE_LAB_STAGING=/absolute/path/outside/repositories/staging
ORACLE_LAB_CONFIG=config

# Operator-only live coding-agent smoke. Leave disabled during normal tests.
# The template must be immutable and the host list must contain exact DNS names.
# ORACLE_LAB_RUN_LIVE_AGENT_TESTS=1
# ORACLE_LAB_LIVE_AGENT=codex
# ORACLE_LAB_LIVE_SBX_EXECUTABLE=/absolute/path/to/sbx
# ORACLE_LAB_LIVE_SBX_TEMPLATE=registry.example/codex@sha256:<64-lowercase-hex>
# ORACLE_LAB_LIVE_ALLOWED_HOSTS=api.example.invalid,auth.example.invalid
# ORACLE_LAB_LIVE_AGENT_MODEL=
